{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "browsermcp": {
        "type": "local",
        "command": ["npx", "-y", "@browsermcp/mcp@0.1.3"],
        "environment": {
          "BROWSER_MCP_DEBUG": "false"
        }
      }
    }
  },
  "plugins": [
    "opencode-browser-v2"
  ],
  "agents": {
    "browser-automation": {
      "description": "Agent specialized in browser automation tasks",
      "mode": "primary"
    }
  }
}
